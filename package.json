{
  "name": "hon-viet-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Hồn Việt 3D: Đấu Trường Danh Tướng. Chọn danh tướng Việt Nam, dùng vũ khí vui nhộn đánh quái vật phương Tây, farm vàng mua trang bị (Three.js + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.mjs",
    "test:server": "node server/test.mjs",
    "balance": "node tools/balance.mjs"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
