# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỒN VIỆT 3D
# ==========================================

# Địa chỉ máy chủ sảnh WebSocket cố định (dành cho client build trên Vercel/Netlify)
# Ví dụ local: ws://localhost:8787/ws
# Ví dụ production: wss://hon-viet-3d.onrender.com/ws
VITE_SERVER_URL=

# Cổng lắng nghe của máy chủ backend (mặc định: 8787)
PORT=8787

# Đường dẫn tệp lưu trữ bảng xếp hạng
LEADERBOARD_FILE=server/data/leaderboard.json

# Khóa API sinh mô hình 3D (nếu dùng tool CLI tools/gen-model.mjs)
TRIPO_API_KEY=
MESHY_API_KEY=
